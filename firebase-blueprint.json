{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "defaultHC": { "type": "number" },
        "defaultOT": { "type": "number" },
        "company": { "type": "string" },
        "lcb": { "type": "number" },
        "chuyenCan": { "type": "number" },
        "doiSong": { "type": "number" },
        "thamNien": { "type": "number" },
        "bankInfo": {
          "type": "object",
          "properties": {
            "bankName": { "type": "string" },
            "accountNumber": { "type": "string" },
            "accountName": { "type": "string" }
          }
        }
      },
      "required": ["uid", "email", "role"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "shift": { "type": "string", "enum": ["day", "night"] },
        "isHoliday": { "type": "boolean" },
        "hoursHC": { "type": "number" },
        "hoursOT": { "type": "number" }
      },
      "required": ["userId", "date", "shift", "isHoliday", "hoursHC", "hoursOT"]
    },
    "Instruction": {
      "title": "Instruction",
      "description": "App instructions editable by admin",
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "fontSize": { "type": "number" }
      },
      "required": ["icon", "title", "content", "fontSize"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "User complaints",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "company", "phone", "content", "status", "createdAt"]
    },
    "JobPost": {
      "title": "JobPost",
      "description": "Recruitment news",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "mapsUrl": { "type": "string" },
        "interviewTime": { "type": "string" },
        "gender": { "type": "string" },
        "baseSalary": { "type": "number" },
        "allowance": { "type": "number" },
        "requiredDocs": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "interviewTime", "gender", "baseSalary", "allowance", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/attendance/{recordId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    },
    "/instructions/{id}": {
      "schema": "Instruction",
      "description": "Global instructions"
    },
    "/complaints/{id}": {
      "schema": "Complaint",
      "description": "User submitted complaints"
    },
    "/jobs/{id}": {
      "schema": "JobPost",
      "description": "Job recruitment posts"
    }
  }
}
